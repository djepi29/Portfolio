# Copy to .env and fill real values. Never commit .env.
# Tripo: https://platform.tripo3d.ai/api-keys
TRIPO_API_KEY=tsk_your_key_here

# Hunyuan3D local API (free self-hosted) — Blender MCP LOCAL_API mode
BLENDERMCP_HUNYUAN3D_API_URL=http://127.0.0.1:8081

# Optional Tencent Cloud Hunyuan (official API, not free)
BLENDERMCP_HUNYUAN3D_SECRET_ID=
BLENDERMCP_HUNYUAN3D_SECRET_KEY=

# Stripe — public /pay page (deploy these to the website host)
STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_your_key_here
STRIPE_SECRET_KEY_PAY_PAGE=rk_live_your_restricted_key_here

# Stripe — personal admin only (local / private; do NOT deploy with the public site)
STRIPE_SECRET_KEY_ADMIN=rk_live_your_admin_key_here

# Admin TOTP (Google Authenticator) — generate with: npm run admin:auth-setup
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=
# Temporary: required to view QR at /admin/setup — remove after scanning
ADMIN_SETUP_TOKEN=
# Optional extra password on /admin/login
# ADMIN_PASSWORD=
